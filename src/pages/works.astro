---
import Layout from "../layouts/Layout.astro";

const posts = await Astro.glob("./works/*.mdx");
---

<Layout title="My graphic design works">
  <main class="region-content works">
    <div class="region">
      <div class="column column-first">
        <div class="field-body">
          <div class="field-label">
            <span>Works</span>
          </div>
          <h1>Designing with intention</h1>
          <div class="field-heading">
            <p>And love.</p>
          </div>
          <p>
            Working as a freelance graphic designer, I’ve developed a versatile
            practice across branding, visual identities, communication
            campaigns, editorial design and illustration. Working across
            different projects and contexts has taught me to adapt my creative
            approach while keeping a strong focus on concept, meaning and visual
            consistency. I’m particularly drawn to branding and visual
            communication. I believe every visual choice should have a purpose —
            from the overall concept and visual language to the smallest
            details. For me, a strong identity is one that feels coherent,
            distinctive and true to the project it represents.
          </p>
          <p>
            Illustration is also an important part of my practice. I like
            bringing hand-drawn elements into my designs to add a more personal
            and expressive dimension, while creating visual worlds that feel
            unique and memorable.
          </p>

          <div class="field-heading">
            <p>
              Branding. Visual communication. Illustration. Graphic composition.
            </p>
          </div>

          <div class="field-action">
            <p>
              <a href="/contact">Contact me now.</a>
              <br />
            </p>
            Or see my works
            <a href="/works" title="My works"> here</a>
          </div>
        </div>
      </div>
      <div class="column colmun-second">
        <div class="field-list">
          <ul>
            {
              posts.map((post) => {
                return (
                  <li>
                    <div class="work-teaser">
                      <div class="layout">
                        <div class="layout_image">
                          <div class="field-image">
                            <img
                              src={"/" + post.thumb}
                              width="200"
                              height="200"
                              alt="Teaser of project : post.title"
                            />
                          </div>
                        </div>
                        <div class="layout_content">
                          <h2>{post.title}</h2>
                          <time>{post.year}</time>
                          <a href={post.url} title="See this work">
                            See this work
                          </a>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    </div>
  </main>
</Layout>
